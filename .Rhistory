axistype = 0,
seg = 4,
pcol = 1,
plwd = 2,
pfcol = grDevices::adjustcolor(1, alpha.f = 0.20),
cglcol = "grey80",
cglty = 1,
vlcex = 0.8,
title = "Frequency of cell types among all the proteins"
)
# ---- manual side scale (0–100%) ----
usr = par("usr")
par(xpd = NA)
x_axis = usr[1] - 0.18 * diff(usr[1:2])
tick_len = 0.03 * diff(usr[1:2])
segments(x_axis, 0, x_axis, 1, lwd = 2)
ticks = seq(0, 1, by = 0.25)
segments(x_axis, ticks, x_axis + tick_len, ticks, lwd = 2)
text(
x = x_axis - 0.03 * diff(usr[1:2]),
y = ticks,
labels = paste0(seq(0, 100, by = 25), "%"),
adj = 1,
cex = 0.95
)
par(xpd = FALSE)
par(op)
dev.off()
message("Saved: ", normalizePath(out_file))
library(dplyr)
library(tidyr)
library(fmsb)
# ---- TOP 25: % per cell type (only those present) ----
stopifnot(exists("prot_tab"), exists("cell_map"))
plot_df_top25 = prot_tab %>%
filter(is.finite(abs_r)) %>%
arrange(desc(abs_r), padj) %>%
slice_head(n = 25) %>%
left_join(cell_map, by = "seq_id") %>%
mutate(cell_type = ifelse(is.na(cell_type) | cell_type == "", "Unknown", cell_type))
cell_summary = plot_df_top25 %>%
count(cell_type, name = "count_top25") %>%
mutate(pct_top25 = 100 * count_top25 / 25)
radar_vals = cell_summary %>%
select(cell_type, pct_top25) %>%
pivot_wider(names_from = cell_type, values_from = pct_top25, values_fill = 0) %>%
as.data.frame()
radar_df = rbind(
setNames(as.data.frame(as.list(rep(100, ncol(radar_vals)))), colnames(radar_vals)),
setNames(as.data.frame(as.list(rep(0,   ncol(radar_vals)))), colnames(radar_vals)),
radar_vals
)
# ---- SAVE ----
out_file = "top25_celltype_radar_boldlabels.png"
png(out_file, width = 1800, height = 1200, res = 300)
op = par(mar = c(1, 9, 2, 1))
radarchart(
radar_df,
axistype = 0,
seg = 4,
pcol = 1,
plwd = 2,
pfcol = grDevices::adjustcolor(1, alpha.f = 0.20),
cglcol = "grey80",
cglty = 1,
vlcex = 0.9,
title = ""
)
# ---- make ALL cell-type axis labels bold (base graphics) ----
# redraw the labels ourselves in bold, then hide the default ones by overdrawing in background color first
lbls = colnames(radar_vals)
n_lbl = length(lbls)
ang = seq(0, 2*pi, length.out = n_lbl + 1)[-(n_lbl + 1)]  # label angles
r_lab = 1.12  # radius for labels (slightly outside the web)
par(xpd = NA)
# cover default labels by drawing them again in white (works if background is white)
text(r_lab * sin(ang), r_lab * cos(ang), labels = lbls, col = "white", cex = 0.9)
# draw bold labels
text(
r_lab * sin(ang),
r_lab * cos(ang),
labels = lbls,
font = 2,          # 2 = bold
cex = 0.9
)
# ---- manual side scale (0–100%) ----
usr = par("usr")
x_axis = usr[1] - 0.18 * diff(usr[1:2])
tick_len = 0.03 * diff(usr[1:2])
segments(x_axis, 0, x_axis, 1, lwd = 2)
ticks = seq(0, 1, by = 0.25)
segments(x_axis, ticks, x_axis + tick_len, ticks, lwd = 2)
text(
x = x_axis - 0.03 * diff(usr[1:2]),
y = ticks,
labels = paste0(seq(0, 100, by = 25), "%"),
adj = 1,
cex = 0.95
)
par(xpd = FALSE)
par(op)
dev.off()
message("Saved: ", normalizePath(out_file))
