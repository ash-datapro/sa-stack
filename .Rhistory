# ---- build top25 + % per cell type (only those present) ----
stopifnot(exists("prot_tab"), exists("cell_map"))
plot_df_top25 = prot_tab %>%
filter(is.finite(abs_r)) %>%
arrange(desc(abs_r), padj) %>%
slice_head(n = 25) %>%
left_join(cell_map, by = "seq_id") %>%
mutate(cell_type = ifelse(is.na(cell_type) | cell_type == "", "Unknown", cell_type))
cell_summary = plot_df_top25 %>%
count(cell_type, name = "count_top25") %>%
mutate(pct_top25 = 100 * count_top25 / 25)
radar_vals = cell_summary %>%
select(cell_type, pct_top25) %>%
pivot_wider(names_from = cell_type, values_from = pct_top25, values_fill = 0) %>%
as.data.frame()
radar_df = rbind(
setNames(as.data.frame(as.list(rep(100, ncol(radar_vals)))), colnames(radar_vals)),
setNames(as.data.frame(as.list(rep(0,   ncol(radar_vals)))), colnames(radar_vals)),
radar_vals
)
# ---- SAVE (the missing piece was dev.off()) ----
out_file = "cell-radar.png"
png(out_file, width = 2100, height = 1200, res = 300)
op = par(mar = c(1, 9, 2, 1))  # extra left margin so % labels don't get clipped
radarchart(
radar_df,
axistype = 0,
seg = 4,
pcol = 1,
plwd = 2,
pfcol = grDevices::adjustcolor(1, alpha.f = 0.20),
