ticks = seq(0, 1, by = 0.25)
segments(x_axis, ticks, x_axis + tick_len, ticks, lwd = 2)
text(
x = x_axis - 0.03 * diff(usr[1:2]),
y = ticks,
labels = paste0(seq(0, 100, by = 25), "%"),
adj = 1,
cex = 0.95
)
par(xpd = FALSE)
par(op)
dev.off()
message("Saved: ", normalizePath(out_file))
# ---- LOLLIPOP PLOT: top 25 proteins by |partial r|, color = cell type ----
library(ggplot2)
library(dplyr)
best_model = cv_model_fold8
prot_gene_cell_long = protein_gene_celltype_long
stopifnot(exists("Y"), exists("H"), is.matrix(best_model$THETAPM))
stopifnot(exists("prot_gene_cell_long"))
theta = as.numeric(best_model$THETAPM[, 1])
# Base sequence IDs from Y
prot_seq_ids = if (!is.null(colnames(Y))) colnames(Y) else paste0("seq_", seq_len(ncol(Y)))
# Map seq IDs to human-readable protein names if mapping is available
if (exists("Y_seq_to_protein_mapping")) {
mapping_df = Y_seq_to_protein_mapping
map_vec = setNames(mapping_df$final_colname, mapping_df$seq_col)
mapped_names = map_vec[prot_seq_ids]
prot_names = ifelse(is.na(mapped_names), prot_seq_ids, mapped_names)
} else {
prot_names = prot_seq_ids
}
theta_res = lm(theta ~ H)$residuals
prot_tab = lapply(seq_len(ncol(Y)), function(j) {
yj = Y[, j]
yj_res = lm(yj ~ H)$residuals
keep = is.finite(theta_res) & is.finite(yj_res)
if (sum(keep) < 3) {
return(data.frame(
seq_id = prot_seq_ids[j],
protein = prot_names[j],
r = NA_real_,
p = NA_real_
))
}
tst = suppressWarnings(cor.test(theta_res[keep], yj_res[keep]))
data.frame(
seq_id = prot_seq_ids[j],
protein = prot_names[j],
r = unname(tst$estimate),
p = unname(tst$p.value)
)
})
prot_tab = do.call(rbind, prot_tab)
prot_tab$abs_r = abs(prot_tab$r)
prot_tab$padj = p.adjust(prot_tab$p, method = "BH")
# ---- attach a single Cell.type per seq_id (strongest evidence) ----
level_rank_map = c("High" = 3, "Medium" = 2, "Low" = 1, "Not detected" = 0)
cell_map = prot_gene_cell_long %>%
mutate(
level_rank = unname(level_rank_map[Level]),
level_rank = ifelse(is.na(level_rank), -Inf, level_rank)
) %>%
group_by(seq_col) %>%
arrange(desc(level_rank), .by_group = TRUE) %>%
slice(1) %>%
ungroup() %>%
transmute(seq_id = seq_col, cell_type = Cell.type)
# ---- pick TOP 25, then build lollipop df ----
plot_df = prot_tab %>%
filter(is.finite(abs_r)) %>%
arrange(desc(abs_r), padj) %>%
slice_head(n = 25) %>%
left_join(cell_map, by = "seq_id") %>%
mutate(
cell_type = ifelse(is.na(cell_type) | cell_type == "", "Unknown", cell_type),
protein = factor(protein, levels = protein[order(abs_r)])  # order for coord_flip
)
# ---- LOLLIPOP: segment from 0 to |r| + point at |r| ----
p_proteins_lollipop = ggplot(plot_df, aes(x = protein, y = abs_r, color = cell_type)) +
geom_segment(aes(xend = protein, y = 0, yend = abs_r), linewidth = 0.9, alpha = 0.9) +
geom_point(size = 3.0) +
coord_flip() +
labs(
title = "",
subtitle = "",
x = "Protein Names",
y = "Absolute Partial Correlation",
color = "Cell type"
) +
theme_classic(base_size = 11) +
theme(
panel.grid.minor = element_blank(),
axis.text.y = element_text(size = 8),
plot.title = element_text(hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5)
)
print(p_proteins_lollipop)
ggsave("prot-top25.png", p_proteins_lollipop, width = 12, height = 9, dpi = 300)
