library(DBI)
library(RPostgres)

admin_con = dbConnect(
  RPostgres::Postgres(),
  dbname = "postgres",
  host = Sys.getenv("SST_DB_HOST"),
  port = as.integer(Sys.getenv("SST_DB_PORT")),
  user = Sys.getenv("SST_DB_ADMIN_USER"),
  password = Sys.getenv("SST_DB_ADMIN_PASSWORD")
)
